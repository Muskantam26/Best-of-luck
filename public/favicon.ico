<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FBEAE7" />
      <stop offset="100%" stop-color="#F7D6D0" />
    </linearGradient>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="2" stdDeviation="2" flood-color="#C26D70" flood-opacity="0.25"/>
    </filter>
  </defs>
  
  <!-- Outer soft blush circle -->
  <circle cx="32" cy="32" r="30" fill="url(#bgGrad)" stroke="#C26D70" stroke-width="2" />
  
  <!-- Decorative Inner Circle -->
  <circle cx="32" cy="32" r="26" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-dasharray="3 3" opacity="0.8" />
  
  <!-- Cute Ribbon Bow Motif -->
  <g filter="url(#shadow)" transform="translate(1, 1)">
    <!-- Left Loop -->
    <path d="M 32 30 C 23 20, 14 26, 22 34 C 27 38, 30 32, 32 30 Z" fill="#C26D70" />
    <!-- Right Loop -->
    <path d="M 32 30 C 41 20, 50 26, 42 34 C 37 38, 34 32, 32 30 Z" fill="#C26D70" />
    <!-- Ribbon Tails -->
    <path d="M 30 33 C 26 40, 20 46, 23 48 C 26 48, 29 42, 31 35 Z" fill="#D98284" />
    <path d="M 34 33 C 38 40, 44 46, 41 48 C 38 48, 35 42, 33 35 Z" fill="#D98284" />
    <!-- Center Knot -->
    <circle cx="32" cy="31" r="3.5" fill="#FAF7F2" stroke="#C26D70" stroke-width="1.5" />
    <!-- Sparkle Accent -->
    <path d="M 43 17 L 44.5 20 L 47.5 21.5 L 44.5 23 L 43 26 L 41.5 23 L 38.5 21.5 L 41.5 20 Z" fill="#D4AF37" />
  </g>
</svg>